<Project Sdk="Microsoft.NET.Sdk.Web">
  <!--
    A API REST: o contrato HTTP do sistema. Autentica, autoriza, traduz
    pedidos em chamadas ao domínio e erros em ProblemDetails. Regra de
    negócio aqui não há — está no domínio.
  -->
  <PropertyGroup>
    <RootNamespace>PlanejamentoObras.Api</RootNamespace>
    <!-- Onde o dotnet user-jwts guarda a chave dos tokens de desenvolvimento. -->
    <UserSecretsId>planejamento-obras-api</UserSecretsId>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\PlanejamentoObras.Infraestrutura\PlanejamentoObras.Infraestrutura.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="PlanejamentoObras.Api.Testes" />
  </ItemGroup>
</Project>
