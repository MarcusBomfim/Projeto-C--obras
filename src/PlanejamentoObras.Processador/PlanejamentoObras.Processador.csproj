<Project Sdk="Microsoft.NET.Sdk.Web">
  <!--
    O processo que roda o processamento em segundo plano, separado da API:
    escala sozinho, cai sozinho, e a API continua atendendo enquanto ele
    reinicia. Dois ou mais no ar dividem a fila sem tratar nada duas vezes.
    Responde HTTP só para dizer se está vivo e pronto (ADR-0019).
  -->
  <PropertyGroup>
    <RootNamespace>PlanejamentoObras.Processador</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\PlanejamentoObras.Observabilidade\PlanejamentoObras.Observabilidade.csproj" />
    <ProjectReference Include="..\PlanejamentoObras.Processamento\PlanejamentoObras.Processamento.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- Os testes sobem o host como ele é, para perguntar pela saúde dele. -->
    <InternalsVisibleTo Include="PlanejamentoObras.Processamento.Testes" />
  </ItemGroup>
</Project>
