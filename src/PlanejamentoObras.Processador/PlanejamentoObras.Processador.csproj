    reinicia. Dois ou mais no ar dividem a fila sem tratar nada duas vezes.
  -->
  <PropertyGroup>
    <RootNamespace>PlanejamentoObras.Processador</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\PlanejamentoObras.Processamento\PlanejamentoObras.Processamento.csproj" />
  </ItemGroup>
</Project>
