<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsTestProject>true</IsTestProject>
    <TestingPlatformDotnetTestSupport>true</TestingPlatformDotnetTestSupport>
    <RootNamespace>PlanejamentoObras.Api.Testes</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
    <PackageReference Include="Testcontainers.PostgreSql" />
    <PackageReference Include="xunit.v3.mtp-v2" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\PlanejamentoObras.Api\PlanejamentoObras.Api.csproj" />
    <!-- O processador, para os testes que seguem a medição até o painel. -->
    <ProjectReference Include="..\..\src\PlanejamentoObras.Processamento\PlanejamentoObras.Processamento.csproj" />
  </ItemGroup>
  <!--
    O mesmo banco dos testes da infraestrutura: PostgreSQL num contêiner,
    migrado, com os papéis da aplicação e do processador. Aqui ele vive dentro
    do fixture da API.
  -->
  <ItemGroup>
    <Compile Include="..\PlanejamentoObras.Infraestrutura.Testes\Persistencia\BancoDeTestes.cs" Link="Banco\BancoDeTestes.cs" />
  </ItemGroup>
</Project>
